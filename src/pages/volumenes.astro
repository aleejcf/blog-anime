---
import Base from '../layouts/Base.astro';
import { OBRA } from '../consts';
import { getEntradasPublicadas } from '../lib/entradas';
import { ruta } from '../lib/rutas';

const entradas = await getEntradasPublicadas();

// Cuenta cuántas entradas hay por volumen. Puede haber varias: la reseña, un
// análisis de personaje, la comparativa con el anime...
const conteoPorVolumen = new Map<number, number>();
for (const entrada of entradas) {
  const { volumen } = entrada.data;
  if (!volumen) continue;
  conteoPorVolumen.set(volumen, (conteoPorVolumen.get(volumen) ?? 0) + 1);
}

const volumenes = Array.from({ length: OBRA.volumenes }, (_, i) => {
  const numero = i + 1;
  return { numero, cuantas: conteoPorVolumen.get(numero) ?? 0 };
});

const hechos = conteoPorVolumen.size;
const porcentaje = Math.round((hechos / OBRA.volumenes) * 100);
const totalEntradas = [...conteoPorVolumen.values()].reduce((a, b) => a + b, 0);
---

<Base
  titulo="Volúmenes"
  descripcion={`Progreso de las reseñas de los ${OBRA.volumenes} volúmenes de ${OBRA.titulo}.`}
>
  <h2 style="margin-top:0">Los {OBRA.volumenes} volúmenes</h2>

  <p style="color:var(--texto-suave)">
    La novela de <strong>{OBRA.autor}</strong> cerró en {OBRA.anios.split(' - ')[1]} con
    {OBRA.volumenes} volúmenes y {OBRA.capitulos} capítulos. Voy reseñándolos uno
    a uno: <strong>{hechos} de {OBRA.volumenes}</strong> ({porcentaje}%).
  </p>

  <div
    class="barra-progreso"
    role="img"
    aria-label={`${hechos} de ${OBRA.volumenes} volúmenes reseñados`}
  >
    <div style={`width:${porcentaje}%`}></div>
  </div>

  <ul class="volumenes">
    {
      volumenes.map(({ numero, cuantas }) =>
        cuantas > 0 ? (
          <li>
            <a
              class="volumen volumen--hecho"
              href={ruta(`volumenes/${numero}`)}
              title={`Volumen ${numero}: ${cuantas} ${cuantas === 1 ? 'entrada' : 'entradas'}`}
            >
              <b>{numero}</b>
              <span>{cuantas === 1 ? '1 entrada' : `${cuantas} entradas`}</span>
            </a>
          </li>
        ) : (
          <li>
            <div class="volumen" title={`Volumen ${numero}: todavía sin nada escrito`}>
              <b>{numero}</b>
              <span>Pendiente</span>
            </div>
          </li>
        )
      )
    }
  </ul>

  <p style="color:var(--texto-suave);font-size:0.9rem">
    Puedes escribir <strong>varias entradas por volumen</strong> — la reseña, un
    análisis de personaje, la comparativa con el anime. Todas las que lleven
    <code>volumen: {'{número}'}</code> en su encabezado aparecen juntas en la
    página de ese volumen.
    {totalEntradas > 0 && ` Ahora mismo hay ${totalEntradas} en total.`}
  </p>
</Base>
